{
  "permissions": {
    "allow": [
      "Bash(uvx:*)",
      "Bash(uv run:*)",
      "Bash(textutil:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(date:*)",
      "Bash(curl -sL https://github.com/:*)",
      "Bash(unzip:*)",
      "Bash(bash .claude/scripts/cosm.sh:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/cosm.sh prompt-context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/cosm.sh mark-read"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/cosm.sh error-context"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/cosm.sh session-start"
          },
          {
            "type": "command",
            "command": "bash .claude/scripts/cosm.sh index-sync",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/cosm.sh index-sync",
            "async": true
          }
        ]
      }
    ]
  }
}
