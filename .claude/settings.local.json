{
  "permissions": {
    "allow": [
      "Bash(uvx:*)",
      "Bash(uv run:*)",
      "Bash(textutil:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(date:*)",
      "Bash(curl -sL https://github.com/:*)",
      "Bash(unzip:*)",
      "Bash(bash .claude/scripts/cosm.sh:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/cosm.sh open-page"
          }
        ]
      }
    ]
  }
}
